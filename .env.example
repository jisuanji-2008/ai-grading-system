# ─────────────────────────────────────────────
# 复制为 .env 后填入你自己的 Key：cp .env.example .env
# .env 已在 .gitignore 中，永远不会被提交
# ─────────────────────────────────────────────

# 选择服务商：zhipu | deepseek | dashscope | moonshot | openai | siliconflow
LLM_PROVIDER=zhipu

# 你的 API Key（只写在这里，代码里只读 process.env）
LLM_API_KEY=your-api-key-here

# 模型（留空用服务商默认）：
#   zhipu     glm-4-flash 完全免费但判分偏松；glm-4-air 更准，费用极低
#   deepseek  deepseek-chat
# LLM_MODEL=glm-4-flash

# 单次判分超时（毫秒）
LLM_TIMEOUT_MS=120000

# 采样温度：判分要稳定，建议 0
LLM_TEMPERATURE=0

# 首次启动是否写入示例题目（1/0）
SEED_DEMO=1
